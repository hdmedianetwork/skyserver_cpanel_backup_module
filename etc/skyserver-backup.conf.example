# SkyServer Backup Module - configuration
# Copy this file to /etc/skyserver-backup.conf and edit it (installer does
# this automatically on first install). Keep it root-only readable:
#   chmod 600 /etc/skyserver-backup.conf

S3_BUCKET="your-bucket-name"
AWS_DEFAULT_REGION="ap-south-1"

# Leave empty for real Amazon S3. For any S3-compatible provider (Wasabi,
# Backblaze B2, IDrive e2, DigitalOcean Spaces, MinIO, Contabo…) put its
# endpoint here, e.g. "https://s3.us-west-1.wasabisys.com".
S3_ENDPOINT_URL=""

# Use an IAM user scoped to ONLY this bucket (s3:PutObject, GetObject,
# ListBucket, DeleteObject on arn:aws:s3:::your-bucket-name/*). Never reuse
# root/admin AWS keys here.
AWS_ACCESS_KEY_ID="REPLACE_ME"
AWS_SECRET_ACCESS_KEY="REPLACE_ME"

# Backups older than this many days are deleted from S3 automatically.
RETENTION_DAYS=7

# Where account tarballs are staged before being uploaded. Point this at a
# partition with room for your largest account.
BACKUP_WORK_DIR="/root"

# An account is skipped if backing it up would leave less than this much
# free space in BACKUP_WORK_DIR. Filling the disk takes down every site on
# the server, not just the backup, so this margin is deliberately generous.
DISK_SAFETY_MARGIN_MB=2048

# How many minutes one account may take before the run gives up on it and
# moves to the next. Without a limit a single account that hangs stalls the
# whole nightly run, and because the run holds a lock every following night
# is skipped too. Raise it if you host accounts that genuinely take longer.
ACCOUNT_TIMEOUT_MIN=90

# What to do when BACKUP_WORK_DIR cannot hold the account being packaged.
# 1 stages on whichever local filesystem has room (the safety margin above is
# respected wherever it lands); 0 fails the account. A 40GB account cannot be
# packaged in /root on a server whose root filesystem is 50GB.
BACKUP_WORK_DIR_FALLBACK=1

# What to do about a database whose dump fails because a table is marked as
# crashed. 1 runs `mysqlcheck --auto-repair` on it and tries once more; 0
# reports it and moves on. Off by default because repairing writes to a
# customer's data. Either way the account itself is still backed up and the
# database is named in the dashboard.
MYSQL_AUTO_REPAIR=0

# Set to 1 to let cPanel users restore their own backups from their
# dashboard. Leave it 0 until you have verified a restore yourself on a
# throwaway account: a restore overwrites the account's live data and
# cannot be undone.
ENABLE_USER_RESTORE=0

# File holding root's MySQL credentials, passed to mysqldump/mysql as
# --defaults-extra-file. On cPanel this is /root/.my.cnf and you should not
# need to change it; set it only if you keep the credentials elsewhere.
MYSQL_DEFAULTS_FILE="/root/.my.cnf"

# Address to email when a backup run has failures. Empty disables alerts.
ALERT_EMAIL=""
